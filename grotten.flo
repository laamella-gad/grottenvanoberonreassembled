; draws the bottom row (row 24)
$c4f4 code draw_bottom_row
$c51e byte bit_skip_c51e
$c51f code draw_bottom_row_screen_1
; draws the left column into the hidden screen
$c524 code draw_left_column
$c547 byte bit_skip_c547
$c548 code draw_left_column_screen_1
; draws a column of 25 characters and their colours: A = the screen page
$c54a code draw_column
$c555 code draw_column_pass
$c566 code draw_column_tile
$c595 code draw_column_tile_row
$c5a7 code draw_column_page
$c5ac code draw_column_char
$c5af code draw_column_store
$c5c5 code draw_column_next
$c5e6 code draw_column_colours
$c603 code draw_column_done
; draws the right column (column 39)
$c604 code draw_right_column
