$c638 code draw_right_column_screen
$c641 byte bit_skip_c641
$c642 code draw_right_column_screen_1
; map offset of the bottom row: 24 / 8 = 3 rows of tiles down
$c647 word bottom_row_offset
; Sets up the VIC, the SID, the sprites, the barrier characters and the screen,
; then a new game
$c649 code engine_init
$c686 code engine_clear_screens
$c6a5 code engine_clear_sid
$c6d3 code engine_init_sprites
$c732 code engine_init_barrier
; engine sound: frequency added to the noise, and voice 3's frequency (the
; random source)
$c764 word engine_pitch
$c766 word engine_tone
$c768 byte engine_noise_rate
$c769-$c771 byte sprite_colours_init
$c771-$c779 byte sprite_pointers_init
$c779-$c781 byte sprite_coords_init
; sprite collisions: background bits 2-5 (the hull's sides), $ff when the
; guardian touched the ship
$c781 byte collisions
$c782-$c78a byte sprite_coords_init_2
; Once a frame from the raster IRQ: the engine sound, collisions and damage,
; the joystick and the barrier animation
$c78a code frame_handler
$c798 code frame_flame_colour
